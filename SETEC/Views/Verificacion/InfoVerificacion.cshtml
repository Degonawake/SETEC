    <form asp-controller="Verificacion" asp-action="InfoVerificacion" method="get" class="form-floating" id="form" name="form">
        <div style="padding: 20px 0 20px 0;">
            <label class="text-primary text fw-bold">GESTOR DE VERIFICACIONES</label>
            <select class="form-control" id="searchGestor" name="searchGestor" onchange="getForm(event)">
                @if (Model.GroupBy(a => a.Gestor).Count() > 1)
                {
                    <option value="" selected>SELECCIONE GESTOR DE VERIFICACION</option>
                }
                @foreach (var item in Model.GroupBy(a => a.Gestor))
                {
                    <option value="@item.Key">@item.Key</option>

                }
                @if (Model.GroupBy(a => a.Gestor).Count() == 1)
                {
                    <option value="">SELECCIONAR TODOS</option>
                }
            </select>
        </div>
        <div>
            <label class="text-primary text fw-bold">CLIENTE A VERIFICAR</label>
            <select class="form-control" id="search" name="search" onchange="getForm(event)">
                @if (Model.GroupBy(a => a.Identidad, b => b.Nombre_Cliente).Count() > 1)
                {
                    <option value="" selected>SELECCIONE CLIENTE A VERIFICAR</option>
                }
                @foreach (var item in Model.GroupBy(a => a.Identidad, b => b.Nombre_Cliente))
                {
                    <option value="@item.Key">@item.Key - @item.First()</option>

                }
                @if (Model.GroupBy(a => a.Identidad).Count() == 1)
                {
                    <option value="">SELECCIONAR TODOS</option>
                }
            </select>
        </div>
        <br>
        <p class="">CANTIDAD DE VERIFICACIONES PENDIENTES @numcontratos</p>
        <div class="form-floating">
            <input id="floatid" value="@Model.First().id" class="form-control form-floating" readonly />
            <label for="floatFecha_Verificacion" class="text-primary text fw-bold">FECHA PLANEADA DE VERIFICACION:</label>
        </div>
        <div class="form-floating">
            <input id="floatFechac" value="@Model.First().Fecha_Creacion" class="form-control form-floating" readonly />
            <label for="Fecha_Creacion" class="text-primary text fw-bold">FECHA DE CREACION:</label>
        </div>
