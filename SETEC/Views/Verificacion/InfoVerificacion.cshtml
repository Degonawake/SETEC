            function verificaRadio1() 
            {
                console.log("Entro a la funcion verificaRadio1");
                var radio1 = document.getElementById("planta1");
                var radio2 = document.getElementById("planta2");
                radio1.checked=true;
                radio2.checked=false;
            }


            function verificaRadio2() 
            {
                    console.log("Entro a la funcion verificaRadio2");
                var radio1 = document.getElementById("planta1");
                var radio2 = document.getElementById("planta2");
                   radio1.checked=false;
                    radio2.checked=true;
            }
            @*
        document.addEventListener('DOMContentLoaded', function () {
            // Transferir valor del campo floatid al campo id
            var sourceValueId = document.getElementById('floatid').value;
            document.getElementById('id').value = sourceValueId;

            // Transferir valor del campo floatStatus al campo Status
            var sourceValueStatus = document.getElementById('floatStatus').value;
            document.getElementById('floatStatus').value = sourceValueStatus;

            // Transferir valor del campo floatIdentidad al campo Identidad
            var sourceValueIdentidad = document.getElementById('floatIdentidad').value;
            document.getElementById('floatIdentidad').value = sourceValueIdentidad;

            // Transferir valor del campo floatNombre al campo Nombre_Cliente
            var sourceValueNombre = document.getElementById('floatNombre').value;
            document.getElementById('floatNombre_Cliente').value = sourceValueNombre;

            // Transferir valor del campo floatGestor al campo Gestor
            var sourceValueGestor = document.getElementById('floatGestor').value;
            document.getElementById('floatGestor').value = sourceValueGestor;

            // Transferir valor del campo floatTienda al campo Tienda
            var sourceValueTienda = document.getElementById('floatTienda').value;
            document.getElementById('floatTienda').value = sourceValueTienda;

            // Transferir valor del campo floatComentario al campo Comentario
            var sourceValueComentario = document.getElementById('floatComentario').value;
            document.getElementById('floatComentario').value = sourceValueComentario;


            var fechaAgendaFormato = (document.getElementById("floatFechac").textContent).trim();

            function convertirFormato(fechaAgendaFormato) {

                var partesFecha = fechaAgendaFormato.split(" ");
                var partesFechaNumerica = partesFecha[0].split("/");
                var partesHora = partesFecha[1].split(":");
                var fecha = new Date(
                    parseInt(partesFechaNumerica[2]),
                    parseInt(partesFechaNumerica[1]) - 1,
                    parseInt(partesFechaNumerica[0])

                );
                var fechaFormateada = fecha.toISOString().slice(0, 10) + " 00:00:00"

                return fechaFormateada;
            }
            var fechaEnFormato = convertirFormato(fechaAgendaFormato);
            document.getElementById("floatFecha_Creacion").value = fechaEnFormato;
